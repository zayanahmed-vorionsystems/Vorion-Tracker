# ── Neon Postgres ─────────────────────────────────────────────────────────
# Get from https://neon.tech → your project → Connection string
DATABASE_URL="postgresql://neondb_owner:npg_IjYZhCR8qO6z@ep-steep-hall-aokgskgi-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
JWT_SECRET="change-this-to-a-long-random-secret"
NEXTAUTH_SECRET="change-this-to-another-long-random-secret"
NEXTAUTH_URL="https://your-app.vercel.app"

# ── Vercel Blob (screenshot storage) ──────────────────────────────────────
# Auto-set when you add Blob storage in Vercel dashboard
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── Pusher (real-time live monitor) ───────────────────────────────────────
# Free plan at https://pusher.com → create app
PUSHER_APP_ID="your_app_id"
PUSHER_KEY="your_key"
PUSHER_SECRET="your_secret"
PUSHER_CLUSTER="ap2"

# ── Public env vars (safe to expose to browser) ───────────────────────────
NEXT_PUBLIC_PUSHER_KEY="your_key"
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# ── Agent download URLs (set after you upload agent installers to Blob) ───
NEXT_PUBLIC_AGENT_WIN_URL="https://your-blob-url/agent-setup-windows.exe"
NEXT_PUBLIC_AGENT_MAC_URL="https://your-blob-url/agent-setup-mac.dmg"
NEXT_PUBLIC_AGENT_LINUX_URL="https://your-blob-url/agent-linux.tar.gz"
