{
  "name": "worktrack-agent",
  "version": "1.0.0",
  "description": "WorkTrack silent background agent — captures screenshots and tracks time",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on http://localhost:5174 && wait-on dist/main.js && electron .\"",
    "build": "vite build && tsc -p tsconfig.electron.json && node scripts/copy-electron-assets.cjs && electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "active-win": "^8.1.0",
    "axios": "^1.6.8",
    "electron-store": "^8.1.0",
    "form-data": "^4.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "socket.io-client": "^4.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.6",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.yourcompany.worktrack-agent",
    "productName": "WorkTrack Agent",
    "asar": true,
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "files": [
      "dist/**/*",
      "src/capture.html",
      "src/capture-preload.ts",
      "src/capture-renderer.ts"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "WorkTrack Agent"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true
    },
    "dmg": {
      "title": "WorkTrack Agent",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  }
}